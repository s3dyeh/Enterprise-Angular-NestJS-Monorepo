NODE_ENV=development
APP_PORT=3001
APP_NAME="Enterprise API"
API_PREFIX=api
APP_FALLBACK_LANGUAGE=en
APP_HEADER_LANGUAGE=x-custom-lang
FRONTEND_DOMAIN=http://localhost:4200
BACKEND_DOMAIN=http://localhost:3001
APP_CORS_ORIGINS=http://localhost:4200

DATABASE_TYPE=postgres
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_USERNAME=enterprise
DATABASE_PASSWORD=local-development-only
DATABASE_NAME=enterprise
DATABASE_SYNCHRONIZE=false
DATABASE_MAX_CONNECTIONS=10
DATABASE_SSL_ENABLED=false
DATABASE_REJECT_UNAUTHORIZED=false
DATABASE_CA=
DATABASE_KEY=
DATABASE_CERT=
DATABASE_URL=

# Support "local", "s3", "s3-presigned"
FILE_DRIVER=local
ACCESS_KEY_ID=
SECRET_ACCESS_KEY=
AWS_S3_REGION=
AWS_DEFAULT_S3_BUCKET=

MAIL_HOST=localhost
MAIL_PORT=51025
MAIL_USER=
MAIL_PASSWORD=
MAIL_IGNORE_TLS=true
MAIL_SECURE=false
MAIL_REQUIRE_TLS=false
MAIL_DEFAULT_EMAIL=noreply@example.com
MAIL_DEFAULT_NAME=Api
MAIL_CLIENT_PORT=51080

# Replace each secret with a different random value before running the API.
AUTH_JWT_SECRET=replace-with-a-unique-access-token-secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=replace-with-a-unique-refresh-token-secret
AUTH_REFRESH_TOKEN_EXPIRES_IN=30d
AUTH_FORGOT_SECRET=replace-with-a-unique-password-reset-secret
AUTH_FORGOT_TOKEN_EXPIRES_IN=30m
AUTH_CONFIRM_EMAIL_SECRET=replace-with-a-unique-email-confirmation-secret
AUTH_CONFIRM_EMAIL_TOKEN_EXPIRES_IN=1d
AUTH_UNIFORM_ERRORS=true

# Optional accounts created by npm run seed. Passwords need at least 12 characters.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_USER_EMAIL=
SEED_USER_PASSWORD=




# Google reCAPTCHA v3: enabled policy is enforced on both browser and native login/register.
RECAPTCHA_ENABLED=false
RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=
RECAPTCHA_ALLOWED_HOSTNAMES=localhost
RECAPTCHA_MIN_SCORE=0.5

# disabled (local only), standalone, or cluster
REDIS_MODE=standalone
REDIS_URL=redis://127.0.0.1:16379
REDIS_USERNAME=
REDIS_PASSWORD=local-development-only
REDIS_CLUSTER_NODES=
REDIS_TLS=false
REDIS_TLS_CA=
REDIS_KEY_PREFIX=enterprise-local
AUTH_RATE_LIMIT=20
AUTH_RATE_WINDOW_SECONDS=60

# Set trusted proxy CIDRs and a random metrics token in production.
TRUST_PROXY=
METRICS_TOKEN=
SWAGGER_ENABLED=true
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=enterprise-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_TRACES_SAMPLER=parentbased_traceidratio
OTEL_TRACES_SAMPLER_ARG=0.1
