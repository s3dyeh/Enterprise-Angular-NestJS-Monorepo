{
  "name": "@enterprise/api",
  "version": "1.2.0",
  "description": "NestJS API for the enterprise monorepo",
  "author": "",
  "private": true,
  "license": "MIT",
  "scripts": {
    "typeorm": "ts-node ./node_modules/typeorm/cli.js",
    "migration:generate": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:generate",
    "migration:create": "npm run typeorm -- migration:create",
    "migration:run": "ts-node src/database/run-migrations.ts",
    "migration:revert": "npm run typeorm -- --dataSource=src/database/data-source.ts migration:revert",
    "schema:drop": "npm run typeorm -- --dataSource=src/database/data-source.ts schema:drop",
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"*.{json,mjs,md}\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:e2e": "node ../../tools/integration.mjs",
    "seed": "ts-node src/database/seeds/run-seed.ts",
    "typecheck": "tsc --noEmit",
    "format:check": "prettier --check \"src/**/*.ts\" \"*.{json,mjs,md}\"",
    "generate": "nest generate",
    "migration:run:prod": "node dist/database/run-migrations.js",
    "seed:prod": "node dist/database/seeds/run-seed.js",
    "openapi:export": "ts-node src/openapi/export-openapi.ts",
    "test:ci": "jest --runInBand --ci --coverage --reporters=default --reporters=jest-junit",
    "lint:fix": "eslint \"src/**/*.ts\" --max-warnings 0 --fix"
  },
  "dependencies": {
    "@enterprise/contracts": "file:../../libs/contracts",
    "@aws-sdk/client-s3": "3.1011.0",
    "@aws-sdk/s3-request-presigner": "3.1011.0",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/passport": "11.0.5",
    "@nestjs/platform-express": "11.2.5",
    "@nestjs/swagger": "11.4.7",
    "@nestjs/typeorm": "11.0.1",
    "@opentelemetry/api": "1.9.1",
    "@opentelemetry/exporter-trace-otlp-http": "0.222.0",
    "@opentelemetry/instrumentation-express": "0.70.0",
    "@opentelemetry/instrumentation-http": "0.222.0",
    "@opentelemetry/instrumentation-pg": "0.74.0",
    "@opentelemetry/sdk-node": "0.222.0",
    "@prometheus-io/client": "0.16.1",
    "bcryptjs": "3.0.3",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "dotenv": "17.3.1",
    "handlebars": "4.7.9",
    "helmet": "^8.3.0",
    "ioredis": "5.11.1",
    "ms": "2.1.3",
    "multer": "2.4.0",
    "multer-s3": "3.0.1",
    "nestjs-i18n": "10.6.0",
    "nestjs-pino": "5.2.0",
    "nodemailer": "10.0.10",
    "passport": "0.7.0",
    "passport-jwt": "4.0.1",
    "pg": "8.20.0",
    "pino-http": "11.0.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "typeorm": "0.3.31"
  },
  "devDependencies": {
    "@nestjs/cli": "11.0.18",
    "@nestjs/schematics": "11.0.10",
    "@nestjs/testing": "11.2.5",
    "@types/express": "5.0.6",
    "@types/jest": "30.0.0",
    "@types/ms": "2.1.0",
    "@types/multer": "2.1.0",
    "@types/multer-s3": "3.0.3",
    "@types/node": "25.5.0",
    "@types/passport-jwt": "4.0.1",
    "@types/supertest": "7.2.0",
    "@typescript-eslint/eslint-plugin": "8.57.1",
    "@typescript-eslint/parser": "8.57.1",
    "eslint": "10.0.3",
    "eslint-config-prettier": "10.1.8",
    "globals": "^17.4.0",
    "jest": "30.3.0",
    "jest-junit": "17.0.0",
    "prettier": "3.9.8",
    "supertest": "7.2.2",
    "ts-jest": "29.4.6",
    "ts-node": "10.9.2",
    "typescript": "5.9.3",
    "yaml": "^2.9.1"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  },
  "engines": {
    "node": ">=24.15.0"
  },
  "overrides": {
    "multer": "$multer"
  },
  "jest-junit": {
    "outputDirectory": "test-results",
    "outputName": "unit.xml"
  }
}
