{
  "name": "enterprise-web",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:direct": "ng serve",
    "build": "ng build",
    "build:prod": "ng build --configuration production",
    "test": "ng test",
    "test:ci": "ng test --no-watch",
    "lint": "eslint \"src/**/*.{ts,html}\" \"e2e/**/*.ts\" --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,html,scss,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,html,scss,json}\"",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.e2e.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm run test:ci && npm run build:prod",
    "e2e": "playwright test",
    "e2e:ui": "playwright test --ui",
    "lint:fix": "eslint \"src/**/*.{ts,html}\" \"e2e/**/*.ts\" --max-warnings 0 --fix"
  },
  "private": true,
  "overrides": {
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@enterprise/contracts": "file:../../libs/contracts",
    "@angular/cdk": "^22.1.7",
    "@angular/common": "^22.1.7",
    "@angular/compiler": "^22.1.7",
    "@angular/core": "^22.1.7",
    "@angular/forms": "^22.1.7",
    "@angular/material": "^22.1.7",
    "@angular/platform-browser": "^22.1.7",
    "@angular/router": "^22.1.7",
    "@angular/service-worker": "^22.1.7",
    "@fontsource/material-icons": "^5.3.0",
    "@fontsource/noto-sans-arabic": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@jsverse/transloco": "^8.4.0",
    "@turf/area": "^7.4.0",
    "@turf/boolean-intersects": "^7.4.0",
    "@turf/boolean-valid": "^7.4.0",
    "@turf/circle": "^7.4.0",
    "@turf/difference": "^7.4.0",
    "@turf/helpers": "^7.4.0",
    "@turf/intersect": "^7.4.0",
    "@turf/length": "^7.4.0",
    "@turf/union": "^7.4.0",
    "leaflet": "^1.9.4",
    "rxjs": "~7.8.2",
    "tslib": "^2.8.1",
    "zone.js": "~0.16.3"
  },
  "devDependencies": {
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.7",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.63.0",
    "@types/jasmine": "~6.0.0",
    "@types/leaflet": "^1.9.22",
    "@types/node": "^26.6.2",
    "angular-eslint": "22.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "jasmine-core": "~7.0.2",
    "karma": "~6.4.4",
    "karma-chrome-launcher": "~3.2.0",
    "karma-coverage": "~2.2.1",
    "karma-jasmine": "~5.1.0",
    "karma-jasmine-html-reporter": "^2.3.0",
    "prettier": "^3.9.8",
    "typescript": "~6.0.3",
    "typescript-eslint": "8.70.0"
  },
  "engines": {
    "node": "^24.15.0 || ^26.0.0"
  },
  "volta": {
    "node": "24.15.0"
  },
  "license": "MIT"
}
